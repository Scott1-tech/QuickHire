# ── Core ──────────────────────────────────────────────────────────────────────
PORT=3000
# Public base URL used to build invite links (REQUIRED in production so links work)
PUBLIC_URL=
COMPANY_NAME=National Carrier Xpress Corp
# Shown to drivers in emails/SMS for help + on expired-link messages
SUPPORT_CONTACT=safety@ncxpress.com

# ── Dashboard protection ──────────────────────────────────────────────────────
# If set, the workdeck requires this password. Leave blank only for local dev.
ADMIN_PASSWORD=

# ── Data ──────────────────────────────────────────────────────────────────────
# Folder for stored applications/uploads/opt-outs. On Railway, mount a Volume here.
DATA_DIR=./data

# ── Database (Python FastAPI backend in ./backend) ────────────────────────────
# The Python backend stores candidates/carriers/portfolios in Postgres. The Node
# backend (server.js) ignores this and uses the JSON file store under DATA_DIR.
# Accepts postgres:// or postgresql:// URLs (the driver is upgraded to asyncpg).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/quickhire

# ── Application links ──────────────────────────────────────────────────────────
# Days before an application link expires (default 14).
LINK_TTL_DAYS=14

# ── Email: Resend (primary) ───────────────────────────────────────────────────
# Sign up at https://resend.com → API Keys → create key. Then verify your sending
# domain (Domains tab) and set EMAIL_FROM to an address on that domain.
# Until a domain is verified you can test with EMAIL_FROM="Acme <onboarding@resend.dev>".
RESEND_API_KEY=
EMAIL_FROM=National Carrier Xpress Corp <recruiting@yourdomain.com>
REPLY_TO_EMAIL=recruiting@yourdomain.com
# Email address notified when a driver submits an application
NOTIFY_EMAIL=

# ── Email: SMTP (fallback, optional) ──────────────────────────────────────────
# Used only if RESEND_API_KEY is not set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── SMS: Twilio ───────────────────────────────────────────────────────────────
# Sign up at https://twilio.com. Account SID + Auth Token are on the Console
# dashboard. TWILIO_FROM is a Twilio phone number you provision (Messaging-capable).
# NOTE: For business SMS to US numbers, Twilio requires A2P 10DLC registration
# (brand + campaign) before it will deliver reliably — complete this in the Twilio
# console. Point the number's inbound Messaging webhook at:
#   <PUBLIC_URL>/api/twilio/inbound   (HTTP POST)  ← needed for STOP opt-out
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Molly AI (checklist summaries) + Anna agent ───────────────────────────────
# Also powers Anna's lead normalization, document scanning, and compliance
# narration. Without it, Anna runs in deterministic mode (rules only).
ANTHROPIC_API_KEY=
# Optional model overrides for Anna (defaults: Haiku 4.5 intake / Opus 4.8 compliance)
ANNA_FAST_MODEL=
ANNA_SMART_MODEL=
ANNA_CONCURRENCY=4

# ── Anna compliance integrations (MVR / PSP / Clearinghouse) ──────────────────
# When a provider's *_API_URL and *_API_KEY are both set, Anna calls it for real;
# otherwise that check returns a clearly-flagged "simulated" pull (no records).
# Driver consent is required and enforced before any pull.
MVR_API_URL=
MVR_API_KEY=
PSP_API_URL=
PSP_API_KEY=
CLEARINGHOUSE_API_URL=
CLEARINGHOUSE_API_KEY=

# ── Telegram (Documents tab "Send to Telegram") ───────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── DocuSign e-Signature (offer letters & consents) ───────────────────────────
# Send QuickHire documents to drivers for e-signature. Contracts AUTO-FILL from
# the driver's application (CDL, address, DOB…) so they only review & correct.
# When these are unset, DocuSign runs in SIMULATED mode (envelopes are created
# locally and clearly flagged) so the whole flow is demoable with no account.
#
# Auth uses JWT Grant (server-to-server). In the DocuSign Admin console:
#   1. Create an app / Integration Key (this is DOCUSIGN_INTEGRATION_KEY).
#   2. Add an RSA keypair; paste the PRIVATE key below (or use *_PATH).
#   3. Find your API Account ID and the impersonated User ID (API Username GUID).
#   4. Grant the integration consent once (the server logs the consent URL).
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
# Provide the RSA private key inline (\n-escaped is fine) OR as a file path.
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_PRIVATE_KEY_PATH=
# Endpoints — defaults target the DocuSign DEMO/sandbox environment.
#   Demo: account-d.docusign.com + https://demo.docusign.net
#   Prod: account.docusign.com   + https://<region>.docusign.net
DOCUSIGN_OAUTH_BASE=account-d.docusign.com
DOCUSIGN_API_BASE=https://demo.docusign.net
# Optional: brand applied to envelopes, and the redirect after embedded signing.
DOCUSIGN_BRAND_ID=
DOCUSIGN_RETURN_URL=
# Optional: HMAC secret for verifying DocuSign Connect webhooks. Point a Connect
# config at <PUBLIC_URL>/api/docusign/webhook with "Include HMAC Signature" on.
DOCUSIGN_WEBHOOK_SECRET=
