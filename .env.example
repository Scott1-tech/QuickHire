# ---- Core ----
PORT=3000
# Public base URL used to build invite links (set this on Railway to your domain)
PUBLIC_URL=
COMPANY_NAME=National Carrier Xpress Corp

# ---- Dashboard protection ----
# If set, the company workdeck requires this password. Leave blank for open (dev only).
ADMIN_PASSWORD=

# ---- Data ----
# Folder for stored applications + uploads. On Railway, mount a Volume here.
DATA_DIR=./data

# ---- Email invites (optional; without these, links are shown to copy/share) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Email address that gets notified when a driver submits an application
NOTIFY_EMAIL=

# ---- SMS invites (optional, Twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
